[Unit]
Description=ShariaGuard SGRC gateway (agen AI)
After=network-online.target

[Service]
WorkingDirectory=/opt/sgrc-office
EnvironmentFile=/opt/sgrc-office/.env
ExecStart=/usr/bin/node server/sgrc-gateway-adapter.js
Restart=always
RestartSec=3
User=sgrc
StateDirectory=sgrc-office

[Install]
WantedBy=multi-user.target
