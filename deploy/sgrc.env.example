# /opt/sgrc-office/.env  — salin dari file ini, isi nilainya, chmod 600
NODE_ENV=production
HOST=127.0.0.1
PORT=8113

# Studio -> gateway SGRC
HERMES3D_GATEWAY_URL=ws://localhost:18790
HERMES3D_GATEWAY_ADAPTER_TYPE=hermes
HERMES3D_GATEWAY_TOKEN=GANTI_TOKEN_ACAK_32_KARAKTER
UPSTREAM_ALLOWLIST=localhost,127.0.0.1
# Wajib saat Studio diakses publik: pengunjung harus memasukkan token ini
STUDIO_ACCESS_TOKEN=GANTI_TOKEN_AKSES_STUDIO

# Gateway SGRC
SGRC_ADAPTER_HOST=127.0.0.1
SGRC_ADAPTER_PORT=18790
SGRC_GATEWAY_TOKEN=GANTI_TOKEN_ACAK_32_KARAKTER
SGRC_TENANT_NAME=BPRS Demo
SGRC_TENANT_TIER=

# Mesin AI (SumoPod, OpenAI-compatible). Kosong = mode demo.
SGRC_LLM_BASE_URL=https://ai.sumopod.com/v1
SGRC_LLM_API_KEY=
SGRC_LLM_MODEL=claude-sonnet-4-5
SGRC_LLM_MAX_TOKENS=1800

HERMES_STATE_DIR=/var/lib/sgrc-office
